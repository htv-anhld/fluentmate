{
  "expo": {
    "name": "FluentMate",
    "slug": "fluentmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fluentmate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nokasoft.fluentmate",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "FluentMate cần microphone để bạn luyện nói tiếng Anh"
      }
    },
    "android": {
      "package": "com.nokasoft.fluentmate",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#E6F4FE",
          "dark": {
            "backgroundColor": "#1F2937"
          }
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "FluentMate cần microphone để bạn luyện nói tiếng Anh"
        }
      ],
      "expo-font",
      "./plugins/withAdiRegistration"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9714a8d1-e762-4090-ba54-f83a64dba258"
      }
    },
    "owner": "anhld29"
  }
}
